# Base44 sandbox development defaults — PLACEHOLDERS ONLY, no real credentials.
#
# Loaded BEFORE /run/base44/app.env, so any value supplied through the Base44
# dashboard (or generated as an encrypted development secret) overrides what is
# here. Nothing in this file must ever be a real credential.
#
# SESSION_SECRET must be at least 32 bytes; lib/session.ts rejects anything
# shorter. The placeholder below only exists so the app boots before a real
# secret is delivered.
SESSION_SECRET=base44-development-placeholder-session-secret-0001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RPC endpoints. The app falls back to public endpoints when these are unset, but
# its built-in Ethereum Mainnet fallback (cloudflare-eth.com) now answers
# eth_blockNumber with "-32046 Cannot fulfill request", so a working public
# development endpoint is pinned here for the sandbox. A real provider URL
# (Alchemy/Infura) supplied as a Base44 secret overrides this.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# SEPOLIA_RPC_URL is left unset: the app's built-in Sepolia public fallback works.
