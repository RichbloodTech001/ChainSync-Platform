# Copy to .env.local (development) or .env.production (deployment). Never commit a filled file.
DATABASE_URL=postgresql://user:password@localhost:5432/chainsync?schema=public

# Signs the HttpOnly session cookie. Generate with: openssl rand -base64 48
# Must be at least 32 bytes. Changing it signs out every session.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public base URL used in verification, password-reset and alert emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RPC providers. Public fallbacks are used when unset; they are rate limited and
# not intended for production load.
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=

# Email transport for verification, password-reset and alert emails.
# When SMTP_HOST is unset the rendered message is stored in the EmailMessage
# table (development "outbox") instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ChainSync <no-reply@chainsync.local>

# Monitoring worker cadence in milliseconds (minimum 5000).
MONITOR_INTERVAL_MS=30000
# "debug" enables verbose structured logging.
LOG_LEVEL=info
