# Copy to .env.production and fill in real values. Never commit the filled file.
# Used by docker-compose.prod.yml (production deployment only).

# PostgreSQL running as the `db` service of docker-compose.prod.yml.
POSTGRES_USER=chainsync
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=chainsync

# Signs the HttpOnly session cookie. Generate with:
#   openssl rand -base64 48
# Changing it signs out every session. Must be at least 32 bytes.
SESSION_SECRET=

# Public base URL, used in verification, password-reset and alert emails.
APP_URL=https://chainsync.example.com

# RPC providers (recommended for production; public fallbacks are rate limited).
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=

# Email transport. When SMTP_HOST is unset, verification/reset/alert emails are
# recorded in the EmailMessage table ("outbox") instead of being delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ChainSync <no-reply@chainsync.example.com>

# Monitoring cadence in milliseconds (minimum 5000).
MONITOR_INTERVAL_MS=60000
# Set to "debug" for verbose structured logs.
LOG_LEVEL=info
